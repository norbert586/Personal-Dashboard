# Copy to .env for local production runs. Never commit .env.

# Who may see the console when running the production server (not needed for `npm run dev`).
#   private-network = loopback, LAN and Tailscale addresses only
# Leave unset and the production server refuses every request (fail closed).
ACCESS_MODE=private-network

# Where the feeds come from. live (the default) asks the real APIs; sample answers every feed
# from the saved samples in src/lib/sources/fixtures/, with no network.
# FEEDS=live
