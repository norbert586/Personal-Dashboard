{
  "name": "ratiu-twp",
  "description": "Ratiu Twp: Norbert's personal site as a small 3D pixel-art town, with a Today panel of real morning feeds.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "astro": "^7.4.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
