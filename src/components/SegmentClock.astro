---
import { site } from '../site.config.ts';
import { zonedParts } from '../lib/time.ts';

interface Props {
  now: Date;
}

const { now } = Astro.props;
const { hour, minute } = zonedParts(now);
const twelveHour = site.hourCycle === 'h12';
const hh = twelveHour ? String(hour % 12 || 12) : String(hour).padStart(2, '0');
const mm = String(minute).padStart(2, '0');
---

<div class="clock" data-clock data-time-zone={site.timeZone} data-hour-cycle={site.hourCycle}>
  <time class="lit" datetime={now.toISOString()} data-clock-time>
    <span data-clock-hh>{hh}</span>
    <span class="colon">:</span>
    <span data-clock-mm>{mm}</span>
  </time>
  {twelveHour && (
    <span class="meridiem" data-clock-meridiem>
      {hour < 12 ? 'AM' : 'PM'}
    </span>
  )}
</div>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const twelveHour = clock.dataset.hourCycle === 'h12';
    const time = clock.querySelector('[data-clock-time]');
    const hh = clock.querySelector('[data-clock-hh]');
    const mm = clock.querySelector('[data-clock-mm]');
    const meridiem = clock.querySelector('[data-clock-meridiem]');
    const formatter = new Intl.DateTimeFormat('en-US', {
      timeZone: clock.dataset.timeZone,
      hour: 'numeric',
      minute: '2-digit',
      hourCycle: 'h23',
    });

    const render = () => {
      const now = new Date();
      const parts = Object.fromEntries(formatter.formatToParts(now).map((p) => [p.type, p.value]));
      const hour = Number(parts.hour) % 24;
      if (hh) hh.textContent = twelveHour ? String(hour % 12 || 12) : String(hour).padStart(2, '0');
      if (mm) mm.textContent = parts.minute ?? '00';
      if (meridiem) meridiem.textContent = hour < 12 ? 'AM' : 'PM';
      time?.setAttribute('datetime', now.toISOString());
    };

    // Re-render on each minute boundary.
    const tick = () => {
      render();
      setTimeout(tick, 60_000 - (Date.now() % 60_000) + 50);
    };
    tick();
  }
</script>

<style>
  .clock {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: end;
    column-gap: 0.45em;
    padding: 0.4em 0.6em 0.35em;
    background: var(--glass);
    border-radius: var(--radius-key);
    box-shadow:
      inset 0 1px 4px rgb(0 0 0 / 0.8),
      0 1px 0 var(--edge-light);
    font-family: var(--font-segment);
    font-size: var(--size-24);
    line-height: 1;
    color: var(--phosphor);
  }

  /* Unlit "ghost" segments: decoration, so it lives in CSS rather than in the text. */
  .clock::before {
    content: '88:88';
    color: var(--phosphor-off);
  }

  .clock::before,
  .lit {
    grid-area: 1 / 1;
    justify-self: end;
    white-space: nowrap;
  }

  .lit {
    text-shadow: var(--glow);
  }

  /* The lit colon fades out every other half-second, revealing the ghost colon. */
  .colon {
    animation: colon-blink 1s steps(1) infinite;
  }

  @keyframes colon-blink {
    50% {
      opacity: 0;
    }
  }

  .meridiem {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--size-12);
    color: var(--phosphor-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .colon {
      animation: none;
    }
  }
</style>
