---
import { litSegments, type Severity } from '../lib/meter.ts';

interface Props {
  value: number;
  max: number;
  severity: Severity;
  segments?: number;
}

const { value, max, severity, segments = 10 } = Astro.props;
const lit = litSegments(value, max, segments);
const SEGMENT = 6;
const GAP = 2;
const width = segments * (SEGMENT + GAP) - GAP;
---

<svg
  class:list={['ledbar', severity]}
  viewBox={`0 0 ${width} 10`}
  preserveAspectRatio="none"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {Array.from({ length: segments }, (_, i) => (
    <rect
      x={i * (SEGMENT + GAP)}
      y="0"
      width={SEGMENT}
      height="10"
      rx="1"
      class={i < lit ? 'on' : 'off'}
    />
  ))}
</svg>

<style>
  .ledbar {
    width: 100%;
    height: 0.75rem;
  }

  .off {
    fill: var(--phosphor-off);
  }

  .normal .on {
    fill: var(--severity-normal);
  }

  .high .on {
    fill: var(--severity-high);
  }

  .critical .on {
    fill: var(--severity-critical);
  }
</style>
