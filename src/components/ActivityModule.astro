---
import Module from './Module.astro';
import type { Reading } from '../lib/readings.ts';
import type { CodeActivity } from '../lib/sources/github.ts';
import { percentChange, quantize, summarize } from '../lib/activity.ts';

interface Props {
  reading: Reading<CodeActivity>;
}

const { reading } = Astro.props;
const { days, previousTotal } = reading.data;
const stats = summarize(days);
const change = percentChange(stats.total, previousTotal);
const levels = quantize(days.map((day) => day.count));

// LED matrix geometry (SVG user units): columns are weeks, rows are Monday → Sunday.
const PITCH = 16;
const RADIUS = 5.5;
const LEFT = 30;
const TOP = 18;
const RIGHT = 14; // room for a month label that starts in the last column
const columns = Math.ceil(days.length / 7);
const width = LEFT + columns * PITCH + RIGHT;
const height = TOP + 7 * PITCH;

const asDate = (iso: string) => new Date(`${iso}T12:00:00Z`);
const dayLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});
const monthLabel = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'short' });
const weekLabel = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'short',
  day: 'numeric',
});

const weeks = Array.from({ length: columns }, (_, column) =>
  days.slice(column * 7, column * 7 + 7),
);

// Month labels above the first column of each month, skipping any that would collide.
const months: Array<{ x: number; text: string }> = [];
weeks.forEach((week, column) => {
  const first = week[0];
  if (!first) return;
  const month = asDate(first.date).getUTCMonth();
  const previous = weeks[column - 1]?.[0];
  const changed = !previous || asDate(previous.date).getUTCMonth() !== month;
  const lastX = months.at(-1)?.x ?? -Infinity;
  const x = LEFT + column * PITCH;
  if (changed && x - lastX >= PITCH * 3)
    months.push({ x, text: monthLabel.format(asDate(first.date)) });
});

const weekdayLabels = [
  { row: 0, text: 'Mon' },
  { row: 2, text: 'Wed' },
  { row: 4, text: 'Fri' },
];

const commits = (count: number) => `${count} ${count === 1 ? 'commit' : 'commits'}`;
const summary = stats.busiest
  ? `${commits(stats.total)} over ${columns} weeks. Busiest day: ${dayLabel.format(asDate(stats.busiest.date))}, ${commits(stats.busiest.count)}.`
  : `No commits in the last ${columns} weeks.`;
---

<Module
  id="activity"
  title="Code activity"
  area="activity"
  provenance={reading.provenance}
  detail={reading.detail}
>
  <div class="activity">
    <div class="tiles">
      <div class="tile">
        <p class="label">Commits, last {columns} weeks</p>
        <p class="value">{stats.total.toLocaleString('en-US')}</p>
        {change !== null && (
          <p class="delta">
            <span class:list={['arrow', change >= 0 ? 'up' : 'down']} aria-hidden="true">
              {change >= 0 ? '▲' : '▼'}
            </span>
            {change >= 0 ? '+' : '−'}
            {Math.abs(change)}% vs previous {columns} weeks
          </p>
        )}
      </div>
      <div class="tile">
        <p class="label">Active days</p>
        <p class="value">
          {stats.activeDays} <span class="unit">of {days.length}</span>
        </p>
      </div>
      <div class="tile">
        <p class="label">Longest streak</p>
        <p class="value">
          {stats.longestStreak}{' '}
          <span class="unit">{stats.longestStreak === 1 ? 'day' : 'days'}</span>
        </p>
      </div>
    </div>

    <figure class="matrix">
      <div class="screen">
        <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="activity-summary">
          <title id="activity-summary">{summary}</title>
          {months.map((month) => (
            <text x={month.x + 1} y="10">
              {month.text}
            </text>
          ))}
          {weekdayLabels.map(({ row, text }) => (
            <text x="0" y={TOP + row * PITCH + PITCH / 2 + 3.5}>
              {text}
            </text>
          ))}
          {days.map((day, index) => (
            <circle
              cx={LEFT + Math.floor(index / 7) * PITCH + PITCH / 2}
              cy={TOP + (index % 7) * PITCH + PITCH / 2}
              r={RADIUS}
              class={`l${levels[index] ?? 0}`}
            >
              <title>{`${dayLabel.format(asDate(day.date))}: ${commits(day.count)}`}</title>
            </circle>
          ))}
        </svg>
        <div class="legend" aria-hidden="true">
          <span>Less</span>
          <svg viewBox="0 0 76 12">
            {[0, 1, 2, 3, 4].map((level) => (
              <circle cx={6 + level * 16} cy="6" r="5" class={`l${level}`} />
            ))}
          </svg>
          <span>More</span>
        </div>
      </div>
      <figcaption class="visually-hidden">{summary}</figcaption>
    </figure>
  </div>

  <details class="table-view">
    <summary>Show as table</summary>
    <table>
      <caption class="visually-hidden">Commits per week</caption>
      <thead>
        <tr>
          <th scope="col">Week of</th>
          <th scope="col">Commits</th>
          <th scope="col">Active days</th>
        </tr>
      </thead>
      <tbody>
        {weeks.map((week) => (
          <tr>
            <th scope="row">{week[0] ? weekLabel.format(asDate(week[0].date)) : ''}</th>
            <td>{week.reduce((sum, day) => sum + day.count, 0)}</td>
            <td>{week.filter((day) => day.count > 0).length}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</Module>

<style>
  .activity {
    display: grid;
    gap: var(--space-5);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-4);
  }

  .label {
    font-size: var(--size-12);
    color: var(--ink-muted);
  }

  .value {
    font-size: var(--size-36);
    font-weight: 700;
    line-height: 1.1;
  }

  .unit {
    font-size: var(--size-14);
    font-weight: 400;
    color: var(--ink-muted);
  }

  .delta {
    font-size: var(--size-12);
    color: var(--ink-muted);
  }

  .arrow {
    margin-inline-end: 0.3em;
  }

  .arrow.up {
    color: var(--live);
  }

  .screen {
    padding: var(--space-4);
    background: var(--glass);
    border-radius: 8px;
    box-shadow:
      inset 0 1px 6px rgb(0 0 0 / 0.85),
      0 1px 0 var(--edge-light);
  }

  /* The glass hugs the matrix instead of leaving dead screen beside it. */
  .matrix .screen {
    width: fit-content;
    max-width: 100%;
  }

  .matrix svg {
    width: 22rem;
    max-width: 100%;
  }

  .matrix text {
    fill: var(--phosphor-dim);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .l0 {
    fill: var(--ramp-0);
  }
  .l1 {
    fill: var(--ramp-1);
  }
  .l2 {
    fill: var(--ramp-2);
  }
  .l3 {
    fill: var(--ramp-3);
  }
  .l4 {
    fill: var(--ramp-4);
  }

  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--size-12);
    color: var(--phosphor-dim);
  }

  .legend svg {
    width: 4.75rem;
  }

  .table-view {
    margin-block-start: var(--space-4);
  }

  .table-view > summary {
    width: fit-content;
    padding-block: var(--space-1);
    font-size: var(--size-14);
    color: var(--ink-muted);
    cursor: pointer;
  }

  table {
    margin-block-start: var(--space-2);
    border-collapse: collapse;
    font-size: var(--size-14);
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: var(--space-1) var(--space-4) var(--space-1) 0;
    text-align: start;
    border-block-end: 1px solid var(--rule);
  }

  td {
    text-align: end;
  }

  thead th {
    font-size: var(--size-12);
    font-weight: 400;
    color: var(--ink-muted);
  }

  @container (min-width: 36rem) {
    .activity {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
      align-items: start;
    }

    .tiles {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
