---
import { site } from '../site.config.ts';
import SegmentClock from './SegmentClock.astro';
import ThemeKeys from './ThemeKeys.astro';

interface Props {
  now: Date;
  theme: 'auto' | 'light' | 'dark';
}

const { now, theme } = Astro.props;
---

<header class="rail">
  <p class="brand">
    <svg class="stripe" viewBox="0 0 32 20" aria-hidden="true" focusable="false">
      <rect y="0" width="32" height="4" class="s1"></rect>
      <rect y="5.33" width="32" height="4" class="s2"></rect>
      <rect y="10.67" width="32" height="4" class="s3"></rect>
      <rect y="16" width="32" height="4" class="s4"></rect>
    </svg>
    <span class="model">{site.device.model}</span>
    <span class="name">{site.device.name}</span>
  </p>
  <div class="controls">
    <SegmentClock now={now} />
    <ThemeKeys current={theme} />
  </div>
</header>

<style>
  .rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block-end: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stripe {
    width: 32px;
    height: 20px;
  }
  .s1 {
    fill: var(--stripe-1);
  }
  .s2 {
    fill: var(--stripe-2);
  }
  .s3 {
    fill: var(--stripe-3);
  }
  .s4 {
    fill: var(--stripe-4);
  }

  .model {
    font-family: var(--font-display);
    font-size: var(--size-21);
    letter-spacing: 0.02em;
  }

  .name {
    color: var(--ink-muted);
    font-size: var(--size-14);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
</style>
