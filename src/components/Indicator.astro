---
import { provenanceLabel, type Provenance } from '../lib/readings.ts';

interface Props {
  provenance: Provenance;
}

const { provenance } = Astro.props;
---

<p class="indicator" data-state={provenance}>
  <span class="led" aria-hidden="true"></span>
  <span>
    <span class="visually-hidden">Source: </span>
    {provenanceLabel[provenance]}
  </span>
</p>

<style>
  .indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--size-12);
    line-height: 1.2;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  /* Shape + colour + word: filled = real data, ring = sample, red = offline. */
  .led {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  [data-state='live'] .led {
    background: var(--live);
  }

  [data-state='local'] .led {
    background: var(--ink-muted);
  }

  [data-state='sample'] .led {
    border: 1.5px solid var(--ink-muted);
  }

  [data-state='offline'] .led {
    background: var(--offline);
  }
</style>
