---
import Module from './Module.astro';
import CassetteSpine from './CassetteSpine.astro';
import type { Reading } from '../lib/readings.ts';
import type { Project } from '../lib/sources/projects.ts';

interface Props {
  reading: Reading<Project[]>;
  now: Date;
}

const { reading, now } = Astro.props;
const onShelf = reading.data.filter((project) => project.status !== 'archived');
const archived = reading.data.filter((project) => project.status === 'archived');
---

<Module
  id="projects"
  title="Projects"
  area="projects"
  provenance={reading.provenance}
  detail={reading.detail}
>
  {reading.data.length === 0 ? (
    <p class="empty">No projects yet. Add one in src/content/projects.</p>
  ) : (
    <ul class="shelf">
      {onShelf.map((project) => (
        <CassetteSpine project={project} now={now} />
      ))}
    </ul>
  )}
  {archived.length > 0 && (
    <details class="archive">
      <summary>Archived ({archived.length})</summary>
      <ul class="shelf">
        {archived.map((project) => (
          <CassetteSpine project={project} now={now} />
        ))}
      </ul>
    </details>
  )}
</Module>

<style>
  /* Spines stacked on a shelf: the seam colour shows between them. */
  .shelf {
    display: grid;
    gap: 3px;
    padding: 3px;
    background: var(--seam);
    border-radius: 3px;
  }

  /* A wide shelf becomes a two-column tape rack; an odd count leaves an empty slot. */
  @container (min-width: 52rem) {
    .shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .archive {
    margin-block-start: var(--space-3);
  }

  .archive > summary {
    width: fit-content;
    padding-block: var(--space-1);
    font-size: var(--size-14);
    color: var(--ink-muted);
    cursor: pointer;
  }

  .archive[open] > summary {
    margin-block-end: var(--space-2);
  }

  .empty {
    color: var(--ink-muted);
  }
</style>
