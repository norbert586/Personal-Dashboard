---
import Module from './Module.astro';
import LedBar from './LedBar.astro';
import type { Reading } from '../lib/readings.ts';
import type { Device } from '../lib/sources/devices.ts';
import { severity, severityLabel } from '../lib/meter.ts';
import { formatUptime } from '../lib/time.ts';

interface Props {
  reading: Reading<Device[]>;
  now: Date;
}

const { reading, now } = Astro.props;

const lastReport = (seen: Date) => {
  const minutes = Math.max(0, Math.round((now.getTime() - seen.getTime()) / 60_000));
  return minutes === 0 ? 'Just now' : `${minutes} min ago`;
};
---

<Module
  id="devices"
  title="Devices"
  area="devices"
  provenance={reading.provenance}
  detail={reading.detail}
>
  {reading.data.length === 0 && <p class="empty">No devices reporting.</p>}
  {reading.data.map((device) => (
    <article class="device" aria-labelledby={`device-${device.name}`}>
      <div class="device-head">
        <h3 id={`device-${device.name}`}>
          {device.name} <span class="role">{device.role}</span>
        </h3>
        <p class="state" data-online={String(device.online)}>
          <span class="lamp" aria-hidden="true" />
          {device.online ? 'Online' : 'Offline'}
        </p>
      </div>
      <dl class="facts">
        <div>
          <dt>Uptime</dt>
          <dd>{formatUptime(device.uptimeSeconds)}</dd>
        </div>
        <div>
          <dt>Last report</dt>
          <dd>{lastReport(device.lastSeen)}</dd>
        </div>
      </dl>
      <div class="screen">
        <ul class="metrics">
          {device.metrics.map((metric) => {
            const level = severity(metric);
            return (
              <li class="metric">
                <span class="name">{metric.label}</span>
                <LedBar value={metric.value} max={metric.max} severity={level} />
                <span class="reading">{metric.display}</span>
                <span class:list={['level', level]}>{severityLabel[level]}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </article>
  ))}
</Module>

<style>
  .device + .device {
    margin-block-start: var(--space-5);
  }

  .device-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--size-18);
    letter-spacing: 0.02em;
  }

  .role {
    margin-inline-start: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--size-14);
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--size-14);
  }

  .lamp {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--offline);
  }

  [data-online='true'] .lamp {
    background: var(--live);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--size-14);
  }

  .facts div {
    display: flex;
    gap: var(--space-2);
  }

  .facts dt {
    color: var(--ink-muted);
  }

  .screen {
    padding: var(--space-4);
    background: var(--glass);
    border-radius: 8px;
    box-shadow:
      inset 0 1px 6px rgb(0 0 0 / 0.85),
      0 1px 0 var(--edge-light);
    color: var(--phosphor);
    font-family: var(--font-mono);
    font-size: var(--size-14);
  }

  .metrics {
    display: grid;
    gap: var(--space-3);
  }

  .metric {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'name reading'
      'bar  level';
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  .name {
    grid-area: name;
    color: var(--phosphor-dim);
  }

  .metric :global(.ledbar) {
    grid-area: bar;
  }

  .reading {
    grid-area: reading;
    text-align: end;
    white-space: nowrap;
  }

  .level {
    grid-area: level;
    min-width: 5.5rem;
    text-align: end;
    font-size: var(--size-12);
    color: var(--phosphor-dim);
  }

  .level.high,
  .level.critical {
    color: var(--phosphor);
    font-weight: 700;
  }

  .empty {
    color: var(--ink-muted);
  }

  @container (min-width: 30rem) {
    .metric {
      grid-template-columns: 9rem minmax(4rem, 1fr) 7.5rem 4.5rem;
      grid-template-areas: 'name bar reading level';
    }

    .level {
      min-width: 0;
    }
  }
</style>
