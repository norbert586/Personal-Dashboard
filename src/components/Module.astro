---
import Indicator from './Indicator.astro';
import type { Provenance } from '../lib/readings.ts';

interface Props {
  id: string;
  title: string;
  /** Grid area name from global.css (status, agenda, tasks, projects, activity, devices). */
  area: string;
  provenance?: Provenance;
  /** Shown only when the source is offline, so failures are never silent. */
  detail?: string | undefined;
}

const { id, title, area, provenance, detail } = Astro.props;
---

<section class:list={['module', `area-${area}`]} aria-labelledby={`${id}-title`}>
  <header class="head">
    <h2 id={`${id}-title`}>{title}</h2>
    {provenance && <Indicator provenance={provenance} />}
  </header>
  <slot />
  {provenance === 'offline' && detail && (
    <p class="offline-detail">
      <span class="mark" aria-hidden="true" />
      {detail}
    </p>
  )}
</section>

<style>
  .module {
    min-width: 0;
    padding: var(--space-5);
    background: var(--panel);
    box-shadow:
      inset 0 1px 0 var(--edge-light),
      inset 0 -1px 0 var(--edge-dark);
    container-type: inline-size;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    margin-block-end: var(--space-4);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--size-14);
    letter-spacing: 0.03em;
  }

  .offline-detail {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    font-size: var(--size-14);
  }

  .mark {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--offline);
  }
</style>
