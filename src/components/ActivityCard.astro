---
import Card from './Card.astro';
import { readingNow, type Reading } from '../lib/readings.ts';
import type { Activity } from '../lib/sources/activity.ts';
import { formatRelative } from '../lib/time.ts';

interface Props {
  reading: Reading<Activity>;
  now: Date;
  /** Projects to list, most recent push first. */
  limit?: number;
}

const { reading, now, limit = 5 } = Astro.props;
const at = readingNow(reading, now);
const { repos, newRepos, days } = reading.data;

const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const total = days.reduce((sum, day) => sum + day.pushes, 0);
const today = days.at(-1)?.pushes ?? 0;
const summary =
  total === 0
    ? 'No pushes in the last two weeks.'
    : `${count(total, 'push', 'pushes')} to ${count(repos.length, 'project', 'projects')} in the last two weeks${today > 0 ? `, ${today} today` : ''}.`;

// A pixel bar per day: decorative, since the sentence above says the same.
const BAR = 4;
const HEIGHT = 16;
const busiest = Math.max(1, ...days.map((day) => day.pushes));
const bars = days.map((day, i) => {
  const height = day.pushes === 0 ? 1 : Math.max(2, Math.round((day.pushes / busiest) * HEIGHT));
  return { x: i * BAR, y: HEIGHT - height, height, active: day.pushes > 0 };
});
---

<Card id="activity" title="Coding activity" reading={reading}>
  {reading.provenance !== 'offline' && (
    <>
      <p>{summary}</p>
      {days.length > 0 && (
        <svg
          class="bars"
          viewBox={`0 0 ${days.length * BAR} ${HEIGHT}`}
          width={days.length * BAR * 4}
          height={HEIGHT * 4}
          preserveAspectRatio="none"
          shape-rendering="crispEdges"
          aria-hidden="true"
          focusable="false"
        >
          {bars.map((bar) => (
            <rect
              class:list={{ active: bar.active }}
              x={bar.x}
              y={bar.y}
              width={BAR - 1}
              height={bar.height}
            />
          ))}
        </svg>
      )}
      {repos.length > 0 && (
        <ul class="repos">
          {repos.slice(0, limit).map((repo) => (
            <li class="repo">
              <a href={repo.url}>{repo.name}</a>
              <p class="meta">
                Pushed {formatRelative(repo.lastPush, at)}
                <span aria-hidden="true"> · </span>
                <span class="visually-hidden">, </span>
                {count(repo.pushes, 'push', 'pushes')}
              </p>
            </li>
          ))}
        </ul>
      )}
      {newRepos.length > 0 && (
        <>
          <h3>New repos</h3>
          <ul class="repos">
            {newRepos.map((repo) => (
              <li class="repo">
                <a href={repo.url}>{repo.name}</a>
                <p class="meta">
                  Created {formatRelative(repo.created, at)}
                  {repo.description && `: ${repo.description}`}
                </p>
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  )}
</Card>

<style>
  .bars {
    display: block;
    width: 100%;
    max-width: 14rem;
    height: 2.5rem;
    margin-block: var(--space-3);
  }

  .bars rect {
    fill: var(--panel-hi);
  }

  .bars rect.active {
    fill: var(--maize);
  }

  h3 {
    margin-block: var(--space-3) var(--space-1);
    font-size: var(--size-24);
    color: var(--maize);
  }

  .repos {
    display: grid;
  }

  .repo {
    padding-block: var(--space-2);
    border-block-start: 2px solid var(--panel-lo);
    line-height: 1.3;
  }

  .repo:first-child {
    border-block-start: 0;
  }

  .meta {
    font-size: var(--size-14);
    color: var(--ink-dim);
  }
</style>
