---
import Module from './Module.astro';
import type { Reading } from '../lib/readings.ts';
import type { Task } from '../lib/sources/tasks.ts';
import { calendarDaysBetween, formatDue } from '../lib/time.ts';

interface Props {
  reading: Reading<Task[]>;
  now: Date;
}

const { reading, now } = Astro.props;
---

<Module
  id="tasks"
  title="Tasks"
  area="tasks"
  provenance={reading.provenance}
  detail={reading.detail}
>
  {reading.data.length === 0 ? (
    <p class="empty">Nothing open.</p>
  ) : (
    <ul class="tasks">
      {reading.data.map((task) => {
        const dueSoon = task.due !== undefined && calendarDaysBetween(now, task.due) <= 0;
        return (
          <li class="task">
            <span class="box" aria-hidden="true" />
            <span class="title">{task.title}</span>
            {task.due && (
              <span class:list={['due', { soon: dueSoon }]}>
                <span class="visually-hidden">Due </span>
                {formatDue(task.due, now)}
              </span>
            )}
          </li>
        );
      })}
    </ul>
  )}
</Module>

<style>
  .tasks {
    display: grid;
  }

  .task {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-block-start: 1px solid var(--rule);
  }

  .task:first-child {
    border-block-start: 0;
  }

  .box {
    width: 0.8rem;
    height: 0.8rem;
    translate: 0 0.1rem;
    border: 1.5px solid var(--ink-muted);
    border-radius: 2px;
  }

  .due {
    font-size: var(--size-12);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  /* Due today: a lit lamp plus bolder ink, so it's not colour alone. */
  .due.soon {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 700;
    color: var(--ink);
  }

  .due.soon::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }

  .empty {
    color: var(--ink-muted);
  }
</style>
