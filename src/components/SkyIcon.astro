---
/**
 * The sky as 8×8 pixel art, ported from the prototype's weather icons. Decorative: the words
 * beside it always say the same thing.
 */
import type { Sky } from '../lib/sources/weather.ts';

interface Props {
  sky: Sky;
  /** CSS pixels; a multiple of 8 keeps the pixels crisp. */
  size?: number;
}

const { sky, size = 32 } = Astro.props;

type Pixel = [x: number, y: number, width: number, height: number, ink: string];
const SUN: Pixel[] = [
  [2, 2, 4, 4, 'sun'],
  [3, 0, 2, 1, 'sun'],
  [3, 7, 2, 1, 'sun'],
  [0, 3, 1, 2, 'sun'],
  [7, 3, 1, 2, 'sun'],
];
const HIGH_CLOUD = (ink: string): Pixel[] => [
  [1, 1, 6, 3, ink],
  [2, 0, 3, 1, ink],
];
const PIXELS: Record<Sky, Pixel[]> = {
  clear: SUN,
  partly: [
    [1, 1, 3, 3, 'sun'],
    [2, 0, 1, 1, 'sun'],
    [0, 2, 1, 1, 'sun'],
    [3, 4, 5, 3, 'cloud'],
    [4, 3, 2, 1, 'cloud'],
  ],
  cloudy: [
    [1, 3, 6, 3, 'cloud'],
    [2, 2, 3, 1, 'cloud'],
  ],
  rain: [...HIGH_CLOUD('cloud'), [2, 5, 1, 2, 'rain'], [5, 5, 1, 2, 'rain']],
  snow: [...HIGH_CLOUD('cloud'), [2, 5, 1, 1, 'snow'], [5, 6, 1, 1, 'snow'], [3, 7, 1, 1, 'snow']],
  storm: [
    ...HIGH_CLOUD('cloud-dark'),
    [4, 4, 1, 1, 'sun'],
    [3, 5, 2, 1, 'sun'],
    [3, 6, 1, 1, 'sun'],
    [2, 7, 1, 1, 'sun'],
  ],
  fog: [
    [0, 2, 7, 1, 'cloud'],
    [1, 4, 7, 1, 'cloud'],
    [0, 6, 6, 1, 'cloud'],
  ],
};
---

<svg
  class="sky"
  viewBox="0 0 8 8"
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {PIXELS[sky].map(([x, y, width, height, ink]) => (
    <rect class={ink} {x} {y} {width} {height} />
  ))}
</svg>

<style>
  .sky {
    flex: none;
  }

  .sun {
    fill: var(--sun);
  }

  .cloud {
    fill: var(--cloud);
  }

  .cloud-dark {
    fill: var(--cloud-dark);
  }

  .rain {
    fill: var(--rain);
  }

  .snow {
    fill: var(--snow);
  }
</style>
