---
/** The pixel mark beside a provenance word: filled = live, hollow = sample, red = offline. */
import type { Provenance } from '../lib/readings.ts';

interface Props {
  state: Provenance;
}

const { state } = Astro.props;
---

<span class="mark" data-state={state} aria-hidden="true"></span>

<style>
  .mark {
    flex: none;
    display: inline-block;
    width: 8px;
    height: 8px;
  }

  [data-state='live'] {
    background: var(--live);
  }

  [data-state='local'] {
    background: var(--ink-dim);
  }

  [data-state='sample'] {
    box-shadow: inset 0 0 0 2px var(--ink-dim);
  }

  [data-state='offline'] {
    background: var(--offline);
  }
</style>
