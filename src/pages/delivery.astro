---
/**
 * The delivery mode (ADR-035): a pizza delivery sim on the real streets around the store, at true
 * scale. A three.js island fills the screen, like the town's, with the dashboard floating over it.
 */
import Page from '../layouts/Page.astro';
import { path } from '../lib/paths.ts';
import { site } from '../site.config.ts';

const { storeName, radiusMiles } = site.delivery;
---

<Page
  title={`${storeName} delivery · Ratiu Twp`}
  description={`Drive the real streets within ${radiusMiles} miles of the store, in a 32-bit pixel style.`}
  skip={{ href: '#help', label: 'Skip to the controls and plain pages' }}
>
  <main>
    <canvas
      id="world"
      tabindex="0"
      role="application"
      aria-roledescription="driving game"
      aria-label="The delivery zone. W or the up arrow is the gas, S or the down arrow brakes, and pressed again from a stop reverses, A and D or the left and right arrows steer, Space is the handbrake, C changes the camera, G turns the GPS to your order's door on and off, N changes the time of day, R goes back to the store, Escape opens the menu. Stopped, F gets you out of the car, and beside it F gets you back in; on foot W and S walk and back up, A and D turn, and holding Shift runs."
    ></canvas>
  </main>
  <header class="hud badge">
    <h1>{storeName}</h1>
    <p>
      Delivery · <span id="clock">--:--</span>
    </p>
  </header>
  <nav class="hud tools" aria-label="Controls">
    <button class="key" id="btn-menu" type="button" aria-keyshortcuts="Escape">
      Menu
    </button>
    <button class="key" id="b-camera" type="button" aria-keyshortcuts="C">
      Camera
    </button>
    <button class="key" id="b-time" type="button" aria-keyshortcuts="N" aria-describedby="time-tip">
      Real time
    </button>
    <span id="time-tip" class="visually-hidden">
      Changes the time of day
    </span>
    <button class="key" id="b-gps" type="button" aria-keyshortcuts="G" aria-pressed="false">
      GPS: off
    </button>
  </nav>
  <section class="hud street" aria-label="Where you are">
    <p id="street" aria-live="off">
      Finding the street…
    </p>
    <p id="limit" class="limit" hidden>
      <span class="visually-hidden">Speed limit</span>
      <span id="limit-mph"></span>
    </p>
  </section>
  <section class="hud place" id="place-box" aria-label="What you're beside" hidden>
    <p id="place" aria-live="off"></p>
  </section>
  <section class="hud gps" id="gps-box" aria-label="GPS" hidden>
    <p>
      <span class="gps-tag">GPS</span>
      <span id="gps-to" aria-live="polite"></span>
      <span id="gps-left"></span>
    </p>
  </section>
  <section class="hud ticket" aria-label="Your order">
    <h2>Order</h2>
    <p id="ticket-none">No order. Stop in the delivery parking behind the store to get one.</p>
    <div id="ticket-body" hidden>
      <p id="ticket-to" class="ticket-to" aria-live="polite"></p>
      <p class="ticket-order">
        <span id="ticket-order"></span>
        <span class="visually-hidden">, total</span>
        <span id="ticket-total" class="ticket-total"></span>
      </p>
      <p id="ticket-note" class="ticket-note"></p>
      <p class="ticket-foot">
        <span id="ticket-how" class="ticket-how"></span>
        <span id="ticket-clock" class="ticket-clock"></span>
      </p>
    </div>
  </section>
  <section class="hud map" aria-label="Map">
    <canvas id="minimap" width="168" height="168" aria-hidden="true"></canvas>
    <p class="visually-hidden">
      A small map of the streets around you, turned so that the way you're heading is up, with a
      letter for each landmark: P for the store, H for the hospital, S for a school, C for a church,
      G for a gas station and D for a car dealer. With the GPS on, the route is a thick line and a
      ring marks where it ends.
    </p>
  </section>
  <section class="hud dash" aria-label="Dashboard">
    <div id="dash-car" class="dash-car">
      <p class="speed">
        <span id="mph">0</span>
        <span class="unit">mph</span>
      </p>
      <p class="gear">
        <span class="visually-hidden">Gear</span>
        <span id="gear">P</span>
      </p>
      <svg
        class="revs"
        viewBox="0 0 100 8"
        role="img"
        aria-label="Engine revs"
        preserveAspectRatio="none"
      >
        <rect class="revs-well" x="0" y="0" width="100" height="8"></rect>
        <rect id="revs" class="revs-bar" x="0" y="0" width="0" height="8"></rect>
        <rect class="revs-red" x="86" y="0" width="14" height="2"></rect>
      </svg>
    </div>
    <div id="dash-foot" class="dash-foot" hidden>
      <p id="foot-how" class="foot-how">
        On foot
      </p>
      <p id="foot-car" class="foot-car"></p>
    </div>
  </section>
  <section class="hud prompt" id="prompt" aria-label="Getting out and in" hidden>
    <p>
      <kbd id="prompt-key">F</kbd> <span id="prompt-text"></span>
    </p>
  </section>
  <section class="hud pedals" aria-label="Driving and walking controls">
    <div class="pad-group">
      <button class="pad" id="t-left" type="button" aria-label="Steer left">
        ◀
      </button>
      <button class="pad" id="t-right" type="button" aria-label="Steer right">
        ▶
      </button>
    </div>
    <div class="pad-side">
      <button class="pad door" id="t-door" type="button" aria-keyshortcuts="F" hidden>
        Get out
      </button>
      <div class="pad-group">
        <button class="pad" id="t-brake" type="button" aria-label="Brake; from a stop, reverse">
          Brake
        </button>
        <button class="pad gas" id="t-gas" type="button" aria-label="Gas">
          Gas
        </button>
      </div>
    </div>
  </section>
  <footer id="help" class="hud hint">
    <p id="hint-text">
      W/S gas and brake · A/D steer · Space handbrake · F out and in · Shift run · C camera · G GPS
      · N time · R reset · Esc menu
    </p>
  </footer>
  <dialog id="pause" class="win" aria-labelledby="pause-title">
    <header>
      <h2 id="pause-title">Paused</h2>
      <form method="dialog">
        <button class="key" type="submit">
          Resume
        </button>
      </form>
    </header>
    <div class="win-body">
      <p>
        You're driving for {storeName}, on the real streets within {radiusMiles} miles of the store.
        Stop in the delivery parking behind the store and you're handed an order: the address, what
        they ordered, how they want it handed over, and the time they were quoted, which starts
        counting when you drive out. Pull up, get out and walk to the door: the clock keeps running
        while you do. Nobody answers yet. The GPS is off until you ask, and then shows the way on
        the road and on the map.
      </p>
      <dl>
        <dt>Gas</dt>
        <dd>W or ↑</dd>
        <dt>Brake; from a stop, reverse</dt>
        <dd>S or ↓</dd>
        <dt>Steer</dt>
        <dd>A and D, or ← and →</dd>
        <dt>Handbrake</dt>
        <dd>Space</dd>
        <dt>Get out when stopped, and back in beside the car</dt>
        <dd>F</dd>
        <dt>On foot: walk and back up, turn, run</dt>
        <dd>W and S, A and D, hold Shift</dd>
        <dt>Camera</dt>
        <dd>C</dd>
        <dt>GPS to your order's door, on or off</dt>
        <dd>G</dd>
        <dt>Time of day</dt>
        <dd>N</dd>
        <dt>Back to the store</dt>
        <dd>R</dd>
      </dl>
      <p class="dim">A controller works too: right trigger, left trigger and the left stick.</p>
      <p class="links">
        <button class="key" id="b-reset" type="button" aria-keyshortcuts="R">
          Back to the store
        </button>
        <a class="key" href={path('/')}>
          Walk into town
        </a>
        <a class="key" href={path('/today')}>
          Open Today
        </a>
      </p>
      <p class="dim credit">
        Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors.
      </p>
    </div>
  </dialog>
  <div id="loading" class="hud cover" role="status">
    Warming up the car…
  </div>
  <section id="no-webgl" class="hud cover" aria-labelledby="no-webgl-title" hidden>
    <div class="panel">
      <h2 id="no-webgl-title">Delivery needs WebGL</h2>
      <p id="no-webgl-why">This browser couldn't start it, so the 3D streets can't open here.</p>
      <p>
        <a class="key" href={path('/today')}>
          Read Today instead
        </a>
      </p>
    </div>
  </section>
</Page>

<script>
  import '../game/delivery/main.ts';
</script>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }

  #world {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: block;
    image-rendering: pixelated;
    touch-action: none;
    outline: none;
  }

  #world:focus-visible {
    outline: 3px solid var(--maize);
    outline-offset: -3px;
  }

  .hud {
    position: fixed;
    z-index: 2;
  }

  .badge,
  .street,
  .place,
  .gps,
  .ticket,
  .dash,
  .map {
    background: var(--panel);
    border: 2px solid var(--outline);
    box-shadow: var(--bevel-up);
  }

  .badge {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3));
    inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
    padding: var(--space-1) var(--space-3);
  }

  .badge h1 {
    color: var(--maize);
    font-size: var(--size-28);
    letter-spacing: 0.04em;
  }

  .badge p {
    color: var(--ink-dim);
    font-size: var(--size-14);
  }

  .tools {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3));
    inset-inline-end: calc(env(safe-area-inset-right, 0px) + var(--space-3));
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
    max-width: min(26rem, 56vw);
  }

  /* The street you're on, like the sign at the corner. */
  .street {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3));
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: min(26rem, calc(100vw - 2rem));
    padding: var(--space-1) var(--space-3);
  }

  #street {
    color: var(--ink);
    font: var(--size-24) / 1.1 var(--font-display);
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* What you're beside: a landmark, or the neighbourhood. */
  .place {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3) + 2.9rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    max-width: min(30rem, calc(100vw - 2rem));
    padding: 0 var(--space-2);
    color: var(--ink);
    font: var(--size-14) / 1.5 var(--font-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .place[hidden] {
    display: none;
  }

  /* Where the GPS is taking you, and how far that is. */
  .gps {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3) + 4.75rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    max-width: min(30rem, calc(100vw - 2rem));
    padding: 0 var(--space-2);
    color: var(--ink);
    font: var(--size-14) / 1.5 var(--font-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gps[hidden] {
    display: none;
  }

  .gps-tag {
    margin-inline-end: var(--space-2);
    color: var(--maize);
    font-weight: 600;
  }

  #gps-left {
    margin-inline-start: var(--space-1);
    font-variant-numeric: tabular-nums;
  }

  /* The order you're carrying: a slip under the store's name. */
  .ticket {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3) + 5rem);
    inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
    width: min(17rem, calc(100vw - 2rem));
    padding: var(--space-1) var(--space-2) var(--space-2);
    color: var(--ink);
    font: var(--size-14) / 1.35 var(--font-ui);
  }

  .ticket h2 {
    color: var(--maize);
    font: var(--size-16) / 1.2 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ticket [hidden] {
    display: none;
  }

  .ticket-to {
    font: var(--size-24) / 1.1 var(--font-display);
    letter-spacing: 0.03em;
  }

  .ticket-order,
  .ticket-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .ticket-total,
  .ticket-clock {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .ticket-note {
    color: var(--ink-dim);
  }

  .ticket-foot {
    margin-block-start: var(--space-1);
    padding-block-start: var(--space-1);
    border-block-start: 2px dashed var(--outline);
  }

  .ticket-how {
    font-weight: 600;
  }

  .ticket-clock {
    color: var(--maize);
    font-weight: 600;
  }

  /* Late is said in words; the colour only backs it up. */
  .ticket-clock.late {
    color: var(--night);
    background: var(--loss);
    padding: 0 var(--space-1);
  }

  .limit {
    flex: none;
    min-width: 2rem;
    padding: 0 var(--space-1);
    background: var(--ink);
    color: var(--night);
    font: 600 var(--size-16) / 1.3 var(--font-ui);
    text-align: center;
  }

  .limit[hidden] {
    display: none;
  }

  .map {
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + var(--space-3));
    inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
    padding: var(--space-1);
    line-height: 0;
  }

  #minimap {
    width: 10.5rem;
    height: 10.5rem;
    image-rendering: pixelated;
    background: var(--panel-lo);
  }

  .dash {
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + var(--space-3));
    inset-inline-end: calc(env(safe-area-inset-right, 0px) + var(--space-3));
    min-width: 11rem;
    padding: var(--space-2) var(--space-3);
  }

  .dash-car {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-1) var(--space-3);
  }

  .dash [hidden] {
    display: none;
  }

  /* On foot there's no speed to give: how you're moving, and how far the car is. */
  .foot-how {
    color: var(--maize);
    font: var(--size-28) / 1.1 var(--font-display);
    letter-spacing: 0.03em;
  }

  .foot-car {
    color: var(--ink);
    font: var(--size-16) / 1.3 var(--font-ui);
    font-variant-numeric: tabular-nums;
  }

  /* What F does now, by name, like the town's door prompt. */
  .prompt {
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + 3.2rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    padding: var(--space-1) var(--space-3);
    background: var(--panel);
    border: 2px solid var(--outline);
    box-shadow: var(--bevel-up);
    color: var(--ink);
    font: 600 var(--size-16) / 1.4 var(--font-ui);
  }

  .prompt p {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .prompt[hidden],
  .prompt [hidden] {
    display: none;
  }

  .prompt kbd {
    min-width: 1.6rem;
    padding: 0 var(--space-1);
    background: var(--maize);
    color: var(--night);
    font: inherit;
    text-align: center;
  }

  .speed {
    color: var(--maize);
    font: var(--size-48) / 0.9 var(--font-display);
    font-variant-numeric: tabular-nums;
  }

  .speed .unit {
    color: var(--ink-dim);
    font: var(--size-16) / 1 var(--font-ui);
  }

  .gear {
    min-width: 2.2rem;
    padding: 0 var(--space-2);
    background: var(--panel-lo);
    box-shadow: var(--bevel-down);
    color: var(--ink);
    font: var(--size-28) / 1.2 var(--font-display);
    text-align: center;
  }

  .revs {
    grid-column: 1 / -1;
    width: 100%;
    height: 0.6rem;
  }

  .revs-well {
    fill: var(--panel-lo);
  }

  .revs-bar {
    fill: var(--maize);
  }

  .revs-red {
    fill: var(--loss);
  }

  .hint {
    inset-inline: 0;
    inset-block-end: 0;
    padding: var(--space-2) 12.5rem calc(env(safe-area-inset-bottom, 0px) + var(--space-2));
    color: var(--ink);
    font-size: var(--size-14);
    text-align: center;
    text-shadow:
      1px 1px 0 var(--outline),
      -1px 1px 0 var(--outline),
      1px -1px 0 var(--outline),
      -1px -1px 0 var(--outline);
    pointer-events: none;
  }

  /* On-screen driving controls, for phones and tablets. */
  .pedals {
    display: none;
    inset-inline: 0;
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + var(--space-4));
    justify-content: space-between;
    align-items: flex-end;
    padding-inline: calc(env(safe-area-inset-left, 0px) + var(--space-4));
    pointer-events: none;
  }

  .pad-group {
    display: flex;
    gap: var(--space-3);
    pointer-events: auto;
  }

  .pad {
    min-width: 4.5rem;
    min-height: 4.5rem;
    padding: var(--space-2);
    background: rgb(28 40 70 / 0.82);
    border: 2px solid var(--outline);
    box-shadow: var(--bevel-up);
    color: var(--ink);
    font: 600 var(--size-18) / 1 var(--font-ui);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .pad.gas {
    min-height: 6rem;
    color: var(--maize);
  }

  /* Getting out and in sits over the gas, and only while it would work. */
  .pad-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  .pad-side .pad-group {
    align-items: flex-end;
  }

  .pad.door {
    min-height: 3rem;
    color: var(--maize);
    pointer-events: auto;
  }

  .pad[hidden] {
    display: none;
  }

  .pad[data-held] {
    box-shadow: var(--bevel-down);
    color: var(--maize);
  }

  @media (hover: none) {
    .pedals {
      display: flex;
    }

    .hint {
      display: none;
    }

    /* The map and the dashboard move up, out from under your thumbs. */
    .map {
      inset-block: calc(env(safe-area-inset-top, 0px) + 5.5rem) auto;
    }

    #minimap {
      width: 7rem;
      height: 7rem;
    }

    .dash {
      inset-block: calc(env(safe-area-inset-top, 0px) + 5.5rem) auto;
      min-width: 8rem;
    }
  }

  /* On a phone held upright the buttons wrap to two rows, so the map and dashboard sit lower. */
  @media (hover: none) and (max-width: 40rem) {
    .map,
    .dash {
      inset-block: calc(env(safe-area-inset-top, 0px) + 9.9rem) auto;
    }

    /* The ticket runs under the map and the GPS button, the width of the screen. It says it's an
       order by what's on it, so the heading is left to screen readers and the road gets the room. */
    .ticket h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .ticket {
      inset-block-start: calc(env(safe-area-inset-top, 0px) + 18.1rem);
      width: auto;
      inset-inline-end: calc(env(safe-area-inset-right, 0px) + var(--space-3));
    }

    /* A fourth button would push the others under the street's name: it sits under the dashboard. */
    #b-gps {
      position: fixed;
      inset-block-start: calc(env(safe-area-inset-top, 0px) + 15.2rem);
      inset-inline-end: calc(env(safe-area-inset-right, 0px) + var(--space-3));
    }
  }

  @media (max-width: 40rem) {
    .street {
      inset-block-start: calc(env(safe-area-inset-top, 0px) + 3.2rem);
      inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
      transform: none;
    }

    .place {
      inset-block-start: calc(env(safe-area-inset-top, 0px) + 6rem);
      inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
      transform: none;
    }

    .gps {
      inset-block-start: calc(env(safe-area-inset-top, 0px) + 7.85rem);
      inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
      transform: none;
    }

    .badge p {
      display: none;
    }

    .tools {
      max-width: 62vw;
    }
  }

  /* Driving on a phone held upright, the road gets the screen (ADR-050): the street, the GPS's
     line, the order as one strip, a smaller map and the speed. Everything is back at a stop. */
  @media (hover: none) and (max-width: 40rem) {
    :global(html[data-moving='true']) .badge,
    :global(html[data-moving='true']) .place,
    :global(html[data-moving='true']) #b-camera,
    :global(html[data-moving='true']) #b-time,
    :global(html[data-moving='true']) #b-gps,
    :global(html[data-moving='true']) .ticket-order,
    :global(html[data-moving='true']) .ticket-note,
    :global(html[data-moving='true']) .ticket-how,
    :global(html[data-moving='true']) #ticket-none {
      display: none;
    }

    :global(html[data-moving='true']) .street {
      inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3));
      max-width: calc(100vw - 7.5rem);
    }

