---
/**
 * The town, and the home page (ADR-033): a three.js island that fills the screen (ADR-010), with
 * the game's interface floating over it in bevelled panels. The Today panel opens over it with T
 * and keeps its own page at /today.
 */
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
// For its styles only: the windows show the Today panel's cards, fetched from /today/cards.
import '../components/TodayCards.astro';
import { PLACES } from '../game/world/places.ts';
import { path } from '../lib/paths.ts';
import { formatRelative } from '../lib/time.ts';

// Each place's window, rendered here from the same content the project pages will use, and
// copied into the dialog when you go in.
const projects = new Map((await getCollection('projects')).map((p) => [p.id, p.data]));
const now = new Date();
const STATUS = {
  building: ['Building', 'under construction'],
  live: ['Live', 'open'],
  paused: ['Paused', 'closed for now'],
  archived: ['Archived', 'retired'],
} as const;
// Recent work in days or weeks; older work by its month.
const lastActive = (date: Date) =>
  now.getTime() - date.getTime() < 60 * 86_400_000
    ? formatRelative(date, now)
    : new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
        date,
      );
const windows = PLACES.map((place) => {
  if (place.kind !== 'project') return { place, title: place.title, label: place.title };
  const project = projects.get(place.slug);
  if (!project) throw new Error(`No project content for ${place.slug}`);
  return { place, project, title: project.title, label: `${place.building}: ${project.title}` };
});
---

<Page
  title="Ratiu Twp"
  description="Ratiu Twp: Norbert's projects as a small 3D pixel-art town you can walk around."
  skip={{ href: '#help', label: 'Skip to the controls and plain pages' }}
>
  <main>
    <canvas
      id="world"
      tabindex="0"
      role="application"
      aria-roledescription="town"
      aria-label="Ratiu Twp, the town. Walk with the arrow keys or W A S D, Shift runs, B rides the bike, Q and E turn the camera, N changes the time of day, T opens Today."
    ></canvas>
  </main>
  <header class="hud badge">
    <h1>Ratiu Twp</h1>
  </header>
  <nav class="hud tools" aria-label="Controls">
    <button class="key" id="btn-menu" type="button" aria-keyshortcuts="Escape">
      Menu
    </button>
    <button
      class="key"
      id="b-left"
      type="button"
      aria-label="Turn the camera left"
      aria-keyshortcuts="Q"
    >
      ↺
    </button>
    <button
      class="key"
      id="b-right"
      type="button"
      aria-label="Turn the camera right"
      aria-keyshortcuts="E"
    >
      ↻
    </button>
    <button class="key" id="b-out" type="button" aria-label="Zoom out" aria-keyshortcuts="-">
      −
    </button>
    <button class="key" id="b-in" type="button" aria-label="Zoom in" aria-keyshortcuts="+">
      +
    </button>
    <button class="key" id="b-bike" type="button" aria-pressed="false" aria-keyshortcuts="B">
      Bike
    </button>
    <button class="key" id="b-time" type="button" aria-keyshortcuts="N" aria-describedby="time-tip">
      Real time
    </button>
    <span id="time-tip" class="visually-hidden">
      Changes the time of day
    </span>
    <div id="compass" aria-hidden="true">
      <i>
        <b>N</b>
      </i>
    </div>
  </nav>
  <div class="hud dock">
    <button id="prompt" class="key" type="button" hidden>
      <span class="k" id="prompt-key">
        F
      </span>
      <span id="prompt-text"></span>
    </button>
    <footer id="help" class="hint">
      <a id="ticker" class="ticker" href={path('/today')} aria-keyshortcuts="T">
        <span class="tag">Today</span>
        <span id="ticker-text">The morning update</span>
      </a>
      <p id="hint-text">
        WASD or the arrows walk along the streets. Shift runs, B rides the bike and Space rings its
        bell, Q/E or drag turns the camera, N changes the time, T opens Today.
      </p>
    </footer>
  </div>
  <div id="dim" class="hud" aria-hidden="true"></div>
  <dialog id="window" class="win" aria-labelledby="window-title">
    <header>
      <h2 id="window-title"></h2>
      <form method="dialog">
        <button class="key" type="submit">
          Close
        </button>
      </form>
    </header>
    <div id="window-body"></div>
  </dialog>
  {windows.map(({ place, project, title, label }) => (
    <template data-place={place.id} data-title={title} data-label={label}>
      {place.kind === 'project' && project ? (
        <>
          <p class="dim">
            {place.building}, {STATUS[project.status][1]}
          </p>
          <p>{project.summary ?? 'No summary yet.'}</p>
          <dl>
            <dt>Status</dt>
            <dd>{STATUS[project.status][0]}</dd>
            <dt>Stack</dt>
            <dd>{project.stack.join(', ') || 'Not listed'}</dd>
            <dt>Last activity</dt>
            <dd>
              <time datetime={project.lastActivity.toISOString().slice(0, 10)}>
                {lastActive(project.lastActivity)}
              </time>
            </dd>
          </dl>
          {project.repo && (
            <p>
              <a class="key" href={project.repo} rel="noopener">
                Open on GitHub
              </a>
            </p>
          )}
        </>
      ) : place.kind === 'feed' ? (
        <>
          <p class="dim">Main Street</p>
          <p>{place.note}</p>
          {place.cards.length > 0 && (
            <div class="feed" data-cards={place.cards.join(' ')}>
              <p class="dim">Reading the feed…</p>
            </div>
          )}
          <p>
            <a class="key" href={path('/today')}>
              Open Today
            </a>
          </p>
        </>
      ) : (
        <>
          <p class="dim">Landmark</p>
          <p>{place.kind === 'landmark' && place.note}</p>
        </>
      )}
    </template>
  ))}
  <dialog id="pause" class="win pause" aria-labelledby="pause-title">
    <header>
      <h2 id="pause-title">Paused</h2>
      <form method="dialog">
        <button class="key" type="submit">
          Resume
        </button>
      </form>
    </header>
    <div class="pause-body">
      <ul class="menu" aria-label="Menu">
        <li>
          <button class="menu-item" type="button" data-pane="resume">
            Resume
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="map">
            Map
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="projects">
            Projects
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="inventory">
            Inventory
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="today">
            Today
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="jukebox">
            Jukebox
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="options">
            Options
          </button>
        </li>
        <li>
          <button class="menu-item" type="button" data-pane="quit">
            Quit to DOS
          </button>
        </li>
      </ul>
      <section class="pane" data-pane-body="map" aria-label="Map">
        <h3>Map</h3>
        <p>
          The town is frozen while you look around. The map comes when the town grows to the real
          roads between 23 and 29 Mile.
        </p>
      </section>
      <section class="pane" data-pane-body="projects" aria-label="Projects" hidden>
        <h3>Projects</h3>
        <p class="dim">Every project is a building. Walk up to one, or click it, to go in.</p>
        <ul class="projects">
          {windows
            .filter((w) => w.place.kind === 'project')
            .map((w) => (
              <li>
                <span>{w.title}</span>
                <span class="dim">
                  {w.place.kind === 'project' && w.place.building}
                  {w.project && `, ${STATUS[w.project.status][0].toLowerCase()}`}
                </span>
              </li>
            ))}
        </ul>
      </section>
      <section class="pane" data-pane-body="inventory" aria-label="Inventory" hidden>
        <h3>Inventory</h3>
        <p>
          The tools Norbert builds with, and the projects that use each one, come with the project
          pages.
        </p>
      </section>
      <section class="pane" data-pane-body="today" aria-label="Today" hidden>
        <h3>Today</h3>
        <p>The morning update: weather, scores, comics, movies, news, traffic and flights.</p>
        <p>
          <button class="key" type="button" data-open-today aria-keyshortcuts="T">
            Open Today
          </button>
        </p>
        <p>
          <a href={path('/today')}>Open it as a page</a>
        </p>
      </section>
      <section class="pane" data-pane-body="jukebox" aria-label="Jukebox" hidden>
        <h3>Jukebox</h3>
        <p>
          Chiptune that changes with the place and the time of day is on its way. Until then the
          bike bell is the only song in town.
        </p>
      </section>
      <section class="pane" data-pane-body="options" aria-label="Options" hidden>
        <h3>Options</h3>
        <p>
          Sound, volume, detail and motion settings are on their way. The town already follows your
          device's reduced-motion setting.
        </p>
      </section>
      <section class="pane" data-pane-body="quit" aria-label="Quit to DOS" hidden>
        <h3>Quit to DOS</h3>
        <p>
          DOS mode, the plain-text version of the whole site, is on its way. Until then, Today and
          the buildings' windows have everything.
        </p>
      </section>
    </div>
  </dialog>
  <dialog id="today" class="win today" aria-labelledby="today-title">
    <header>
      <h2 id="today-title">Today</h2>
      <form method="dialog">
        <button class="key" type="submit">
          Close
        </button>
      </form>
    </header>
    <div id="today-body">
      <p class="dim">
        The morning update, as the town has it. <a href={path('/today')}>Open it as a page</a>
      </p>
      <div class="cards" data-cards="*"></div>
    </div>
  </dialog>
  <section id="boot-dos" class="screen dos" aria-label="Starting up" hidden>
    <pre id="boot-text"></pre>
  </section>
  <section id="boot-setup" class="screen setup" aria-labelledby="setup-title" hidden>
    <div class="setup-box">
      <h2 id="setup-title">RATIU TWP SETUP</h2>
      <p>Select your sound device:</p>
      <div class="setup-opts" role="listbox" aria-label="Sound device">
        <button type="button" role="option" aria-selected="true" data-sound="on">
          Sound Blaster 16 (sound on)
        </button>
        <button type="button" role="option" aria-selected="false" data-sound="off">
          No sound
        </button>
      </div>
      <p class="setup-foot">Up and Down to choose. Enter to confirm.</p>
    </div>
  </section>
  <section id="boot-title" class="screen title-screen" aria-labelledby="title-name" hidden>
    <div>
      <p id="title-name" class="title-name">
        RATIU
        <br />
        TWP
      </p>
      <p class="sub">A small Michigan town where every building is a project.</p>
      <button id="btn-start" class="press" type="button">
        Press any key
      </button>
      <p class="copy">© 1995 Ratiu Software. Build 0.4</p>
    </div>
  </section>
  <button id="btn-skip" class="key skip" type="button" hidden>
    Skip intro
  </button>
  <div id="loading" class="hud cover" role="status">
    Building Ratiu Twp…
  </div>
  <section id="no-webgl" class="hud cover" aria-labelledby="no-webgl-title" hidden>
    <div class="panel">
      <h2 id="no-webgl-title">The town needs WebGL</h2>
      <p>This browser couldn't start it, so the 3D town can't open here.</p>
      <p>
        <a class="key" href={path('/today')}>
          Read Today instead
        </a>
      </p>
    </div>
  </section>
</Page>

<script>
  import '../game/main.ts';
</script>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }

  #world {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: block;
    image-rendering: pixelated;
    touch-action: none;
    outline: none;
    cursor: crosshair;
  }

  #world:focus-visible {
    outline: 3px solid var(--maize);
    outline-offset: -3px;
  }

  .hud {
    position: fixed;
    z-index: 2;
  }

  .badge h1 {
    font-size: var(--size-28);
    letter-spacing: 0.04em;
  }

  .badge {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3));
    inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-3));
    padding: var(--space-1) var(--space-3);
    background: var(--panel);
    border: 2px solid var(--outline);
    box-shadow: var(--bevel-up);
    color: var(--maize);
  }

  .tools {
    inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-3));
    inset-inline-end: calc(env(safe-area-inset-right, 0px) + var(--space-3));
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
    max-width: min(520px, 62vw);
  }

  #compass {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--panel);
    border: 2px solid var(--outline);
    box-shadow: var(--bevel-up);
  }

  #compass i {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  #compass i::before {
    content: '';
    position: absolute;
    inset-inline-start: 7px;
    inset-block-start: 7px;
    border: 5px solid transparent;
    border-block-end: 9px solid var(--maize);
    border-block-start: 0;
  }

  #compass b {
    position: absolute;
    inset-inline: 0;
    inset-block-start: -9px;
    text-align: center;
    font: 400 var(--size-12) / 1 var(--font-ui);
  }

  .key[aria-pressed='true'] {
    color: var(--maize);
    box-shadow: var(--bevel-down);
  }

  /* The foot of the screen: the door prompt, then the Today line and the key help. */
  .dock {
    inset-inline: 0;
    inset-block-end: 0;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    pointer-events: none;
  }

  .dock > * {
    pointer-events: auto;
  }

  .hint {
    width: 100%;
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    padding: var(--space-2) max(var(--space-4), env(safe-area-inset-right, 0px))
      calc(env(safe-area-inset-bottom, 0px) + var(--space-2));
    background: rgb(4 7 15 / 0.82);
    color: var(--ink-dim);
    font-size: var(--size-14);
    text-align: center;
  }

  /* One feed at a time, in words; it opens Today. */
  .ticker {
    max-width: 100%;
    color: var(--ink);
    font-size: var(--size-16);
    text-decoration: none;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .ticker .tag {
    margin-inline-end: 0.35em;
    padding: 0 0.4em;
    background: var(--maize);
    color: var(--night);
    font-weight: 600;
  }

  #prompt {
    max-width: calc(100vw - 2rem);
  }

  #prompt[hidden] {
    display: none;
  }

  #prompt .k {
    padding: 0.2rem 0.45rem;
    background: var(--maize);
    color: var(--night);
  }

  #dim {
    inset: 0;
    background: var(--night);
    opacity: 0;
    pointer-events: none;
  }

  .win {
    margin: auto;
    width: min(28rem, calc(100vw - 2rem));
    max-height: min(72vh, 40rem);
    padding: 0;
    background: var(--panel);
    color: var(--ink);
    border: 2px solid var(--outline);
    box-shadow:
      var(--bevel-up),
      0 12px 40px rgb(0 0 0 / 0.55);
  }

  .win[open] {
    display: flex;
    flex-direction: column;
  }

  .win::backdrop {
    background: transparent;
  }

  .win header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--panel-lo);
  }

  .win h2 {
    color: var(--maize);
    font-size: var(--size-28);
  }

  #window-body {
    padding: var(--space-1) var(--space-4) var(--space-4);
    overflow: auto;
    display: grid;
    gap: var(--space-3);
  }

  #window-body dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
  }

  #window-body dt {
    color: var(--ink-dim);
  }

  #window-body dd {
    margin: 0;
  }

  /* A feed's card from the Today panel, without its own panel: the window is the panel. */
  #window-body :global(.card) {
    padding: 0;
    background: none;
    border: 0;
    box-shadow: none;
  }

  /* Today, over the town: the panel's cards in the panel's grid. */
  .today {
    width: min(76rem, calc(100vw - 2rem));
    max-height: min(88vh, 60rem);
  }

  #today-body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-4);
    overflow: auto;
  }

  #today-body .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  @media (max-width: 40rem) {
    .win.today {
      max-height: 92dvh;
    }
  }

  :global(.feed-problem) {
    padding: var(--space-2) var(--space-3);
    background: var(--panel-lo);
    box-shadow: var(--bevel-down);
    color: var(--offline);
  }

  @media (max-width: 40rem) {
    .win {
      width: 100vw;
      max-width: 100vw;
      margin-block-end: 0;
      margin-inline: 0;
      max-height: 70vh;
      padding-block-end: env(safe-area-inset-bottom, 0px);
    }
  }

  .screen {
    position: fixed;
    inset: 0;
    z-index: 6;
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }

  .screen[hidden] {
    display: none;
  }

  .dos {
    place-items: start;
    background: #000;
    color: #c8c8c8;
  }

  .dos pre {
    margin: 0;
    font: var(--size-18) / 1.35 var(--font-ui);
    white-space: pre-wrap;
  }

  .setup {
    background: #0000aa;
    color: #e8e8e8;
  }

  .setup-box {
    display: grid;
    gap: var(--space-3);
    min-width: min(30rem, 100%);
    padding: var(--space-4) var(--space-5);
    border: 3px double #e8e8e8;
  }

  .setup-box h2 {
    font: var(--size-24) / 1.2 var(--font-ui);
    text-align: center;
  }

  .setup-opts {
    display: grid;
    gap: var(--space-1);
  }

  .setup-opts button {
    padding: var(--space-1) var(--space-2);
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .setup-opts button[aria-selected='true'] {
    background: #e8e8e8;
    color: #0000aa;
  }

  .setup-foot {
    color: #aab;
    font-size: var(--size-14);
  }

  .title-screen {
    background: var(--night);
    text-align: center;
  }

  .title-screen > div {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }

  .title-name {
    color: var(--maize);
    font: clamp(4rem, 3rem + 8vw, 9rem) / 0.85 var(--font-display);
    letter-spacing: 0.06em;
    text-shadow: 4px 4px 0 var(--outline);
  }

  .title-screen .sub {
    color: var(--ink-dim);
  }

  .press {
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: transparent;
    color: var(--ink);
    font: var(--size-24) / 1 var(--font-display);
    cursor: pointer;
    animation: blink 1.2s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }

  .copy {
    color: var(--ink-dim);
    font-size: var(--size-12);
  }

  .skip {
    position: fixed;
    z-index: 7;
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + var(--space-4));
    inset-inline-end: calc(env(safe-area-inset-right, 0px) + var(--space-4));
  }

  .skip[hidden] {
    display: none;
  }

  .pause {
    width: min(44rem, calc(100vw - 2rem));
  }

  .pause .pause-body {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4) var(--space-4);
    overflow: auto;
  }

  .menu {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .menu-item {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 600 var(--size-16) / 1.2 var(--font-ui);
    text-align: start;
    cursor: pointer;
  }

  .menu-item:hover,
  .menu-item[aria-current='true'] {
    background: var(--panel-lo);
    color: var(--maize);
  }

  .menu-item[aria-current='true']::before {
    content: '▸ ';
  }

  .pane {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .pane[hidden] {
    display: none;
  }

  .pane h3 {
    color: var(--maize);
    font-size: var(--size-24);
  }

  .projects {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .projects li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  @media (max-width: 40rem) {
